<h1>Widget custom</h1>

<%= form_tag('/', method: :post, id: 'form-plain') do %>
  <%= text_field_tag :email %>
  <%= submit_tag 'Submit plain' %>
<% end %>

<%= form_tag('/', method: :post, id: 'form-manual') do %>
  <%= cloudflare_turnstile_tag data: { theme: 'light' } %>
  <%= submit_tag 'Submit manual' %>
<% end %>
